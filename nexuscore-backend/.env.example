# NexusCore backend configuration — copy to .env and fill in. This file is documentation only:
# it contains no usable secrets, and production refuses to start with placeholder values.

# Application
PORT=4000
# "production" enables fail-fast secret checks, production log levels and hides Swagger.
NODE_ENV=production

# Database (PostgreSQL). Optional pool size: append ?connection_limit=20
NEXUSCORE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# JWT — REQUIRED in production. Two different random values of at least 32 characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Startup fails when either is missing, shorter than 32 characters, a known placeholder, or equal.
NEXUSCORE_JWT_SECRET=
NEXUSCORE_JWT_REFRESH_SECRET=
NEXUSCORE_JWT_EXPIRES_IN=7d
NEXUSCORE_JWT_REFRESH_EXPIRES_IN=30d
NEXUSCORE_JWT_ISSUER=nexuscore

# Browser origins allowed to call the API (comma-separated). Not needed when the frontend and
# /api are served from the same origin by the reverse proxy.
CORS_ORIGINS=https://erp.example.com

# Reverse proxy: which proxy hops to trust for the real client IP (rate limiting, logs).
# "loopback" (default) = IIS/Nginx on the same machine; "false" = no proxy; or a hop count / IP list.
TRUST_PROXY=loopback

# Rate limit per signed-in user (or per client IP when anonymous). Login/password-reset have
# their own stricter limits.
THROTTLE_TTL=60
THROTTLE_LIMIT=600

# Public URL of the application (used in password-reset emails).
APP_PUBLIC_URL=https://erp.example.com

# Outgoing mail for password reset. The company's active SMTP setting (Communication -> SMTP)
# is used first; these are the fallback.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=erp@example.com

# Uploads (MB). Also bounded by the 10 MB JSON body limit for base64 attachment uploads.
UPLOAD_MAX_MB=10

# Swagger/OpenAPI is off in production unless explicitly enabled (restrict it at the proxy if so).
SWAGGER_ENABLED=false

# Initial setup (npm run db:setup) — only used when the admin account does not exist yet.
# Without SEED_ADMIN_PASSWORD a random one-time password is generated and printed once; the
# administrator must change it at first sign-in either way.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_COMPANY_NAME=
SEED_BRANCH_NAME=
SEED_WORKPLACE_NAME=

# RabbitMQ (optional — the API runs without it)
NEXUSCORE_RABBITMQ_URL=
NEXUSCORE_RABBITMQ_EXCHANGE=nexuscore.events

# WhatsApp / Meta (optional)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v17.0
