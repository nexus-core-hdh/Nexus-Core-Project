# Frontend build configuration. NEXT_PUBLIC_* values are compiled into the browser bundle when
# `npm run build` runs — set them in the build environment, then rebuild after any change.

# REQUIRED. Where browsers reach the API:
#   /api/v1                            same origin (reverse proxy sends /api/* to the backend) — recommended
#   https://api.example.com/api/v1     separate origin (then set the backend's CORS_ORIGINS)
# The build fails if this is missing or points at localhost (ALLOW_LOCALHOST_API_URL=true overrides
# that check for local production tests only).
NEXT_PUBLIC_NEXUSCORE_API_URL=/api/v1

# Optional: default from NEXT_PUBLIC_NEXUSCORE_API_URL (used only by older template screens).
# NEXT_PUBLIC_API_URL=
# NEXT_PUBLIC_SOCKET_URL=
